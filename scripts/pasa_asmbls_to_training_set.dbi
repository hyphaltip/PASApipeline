#!/usr/bin/env perl

use FindBin;
use lib ("$FindBin::Bin");
use Pasa_init;
use DB_connect;
use strict;
use Getopt::Long qw(:config no_ignore_case bundling pass_through);
use Gene_obj;
use Nuc_translator;
use CdbTools;
use List::Util qw (min max);



$|=1;
our $SEE = 0;

my $usage =  <<_EOH_;

############################# Options ###############################
#
# Required:
#
# --pasa_transcripts_fasta <string>    the \${pasa_db}.pasa_assemblies.denovo_transcript_isoforms.fasta file
# --pasa_transcripts_gff3 <string>     the \${pasa_db}.denovo_transcript_isoforms.gff3 file
#
#  Optional:
#
# -m <int>                             minimum protein length (default: 100)
#
# -G <string>                          genetic code (default: universal, options: Euplotes, Tetrahymena, Candida, Acetabularia)
#
# -h print this option menu and quit
# -v verbose
#
# -S                                   strand-specific (only analyzes top strand)
# -T <int>                             top longest ORFs to train Markov Model (hexamer stats) (default: 500)
#
#
###################### Process Args and Options #####################

_EOH_

    ;


# required
my ($pasa_transcripts_fasta_file, $pasa_transcripts_gff3_file);


# optional
my ($min_prot_length, $genetic_code, $help, $verbose, $strand_specific_flag, $top_long_orfs);

my $DEBUG = 0; # just prints commands, doesnt execute anything

&GetOptions( 'pasa_transcripts_fasta=s' =>\$pasa_transcripts_fasta_file,
             'pasa_transcripts_gff3=s' => \$pasa_transcripts_gff3_file,
             'm=i' => \$min_prot_length,
             'G=s' => \$genetic_code,
             'h' => \$help,
             'v' =>\$verbose,
             'S' => \$strand_specific_flag,
             'T=i' => \$top_long_orfs,
             'd' => \$DEBUG);


if ($help) {
    die $usage;
}

unless ($pasa_transcripts_fasta_file && $pasa_transcripts_gff3_file) {
    die $usage;
}


## Helper function to find TransDecoder in PATH or pasa-plugins
sub find_transdecoder_tool {
    my ($tool_name) = @_;

    # First try PATH
    my $path_tool = `which $tool_name 2>/dev/null`;
    chomp($path_tool);
    if ($path_tool && -x $path_tool) {
        print STDERR "[TransDecoder] Found $tool_name in PATH: $path_tool\n" if $verbose;
        return $path_tool;
    }

    # Fall back to bundled pasa-plugins
    my $plugin_tool = "$FindBin::Bin/../pasa-plugins/transdecoder/$tool_name";
    if (-x $plugin_tool) {
        print STDERR "[TransDecoder] Found $tool_name in pasa-plugins: $plugin_tool\n" if $verbose;
        return $plugin_tool;
    }

    return undef;
}


main: {


    ## Find TransDecoder: check PATH first, then bundled location
    my $transdecoder_longorf = &find_transdecoder_tool("TransDecoder.LongOrfs");
    my $transdecoder_predict = &find_transdecoder_tool("TransDecoder.Predict");

    unless ($transdecoder_longorf && -x $transdecoder_longorf) {
        die "FATAL: TransDecoder.LongOrfs not found in PATH or pasa-plugins directory\n";
    }
    unless ($transdecoder_predict && -x $transdecoder_predict) {
        die "FATAL: TransDecoder.Predict not found in PATH or pasa-plugins directory\n";
    }

    # Determine TransDecoder util script directory
    # Util scripts are always in the same dir as the main script (conda)
    # or in a sibling util/ dir (bundled)
    my $transdecoder_util_dir;
    if ($transdecoder_longorf) {
        # Get the directory containing the TransDecoder script
        my $real_path = `readlink -f $transdecoder_longorf 2>/dev/null`;
        chomp($real_path);

        if ($real_path && $real_path =~ m{^(.+)/[^/]+$}) {
            my $script_dir = $1;
            # Check if we're already in a util/ directory (conda case)
            if ($script_dir =~ m{/util$}) {
                # Conda: scripts are in util/, util scripts are in the same dir
                $transdecoder_util_dir = $script_dir;
            } else {
                # Bundled: scripts are in transdecoder/, util scripts in util/ subdir
                $transdecoder_util_dir = "$script_dir/util";
            }
        } else {
            # Fallback to bundled util location
            $transdecoder_util_dir = "$FindBin::Bin/../pasa-plugins/transdecoder/util";
        }
    } else {
        # Fallback to bundled util location
        $transdecoder_util_dir = "$FindBin::Bin/../pasa-plugins/transdecoder/util";
    }

    ## Run TransDecoder:

    my $transdecoder_params = "-t $pasa_transcripts_fasta_file ";
        
    if ($genetic_code) {
        $transdecoder_params .= " -G $genetic_code ";
    }
    if ($verbose) {
        $transdecoder_params .= " -v ";
    }
    
    if ($top_long_orfs) {
        $transdecoder_params .= " -T $top_long_orfs ";
    }
    

    my $cmd = "$transdecoder_longorf $transdecoder_params";

    if ($strand_specific_flag) {
        $cmd .= " -S ";
    }

    &process_cmd($cmd);



    if ($min_prot_length) {
        $transdecoder_params .= " -m $min_prot_length ";
    }

    $cmd = "$transdecoder_predict $transdecoder_params";
    &process_cmd($cmd);

    

    ## Convert the output file over to using the genome coordinates:
    
    my $best_candidates_gff3_file = "$pasa_transcripts_fasta_file.transdecoder.gff3";
    
    $cmd = "$transdecoder_util_dir/cdna_alignment_orf_to_genome_orf.pl $pasa_transcripts_fasta_file.transdecoder.gff3 $pasa_transcripts_gff3_file $pasa_transcripts_fasta_file > $pasa_transcripts_fasta_file.transdecoder.genome.gff3";
    &process_cmd($cmd);


    $cmd = "$transdecoder_util_dir/gff3_file_to_bed.pl $pasa_transcripts_fasta_file.transdecoder.genome.gff3 > $pasa_transcripts_fasta_file.transdecoder.genome.bed";
    &process_cmd($cmd);
    

    print STDERR "\n\n** Final PASA best candidate orfs are provided as files: $pasa_transcripts_fasta_file.transdecoder.\*\n\n";
    
    exit(0);


}
    

####
sub process_cmd {
	my ($cmd) = @_;

	print "CMD: $cmd\n";
    
    if ($DEBUG) { 
        return;
    }

	my $ret = system($cmd);

	if ($ret) {
		die "Error, cmd: $cmd died with ret $ret";
	}
	
	return;

}





